---
import type { CollectionEntry } from 'astro:content';
import { dateLabel, defaultResearchImage } from '../lib/content';
import { projectImage } from '../lib/project-image.js';

interface Props {
  entry: CollectionEntry<'projects' | 'research'>;
}

const { entry } = Astro.props;
const href = `/${entry.collection}/${entry.id}/`;
const label = entry.collection === 'research' ? (entry.data.venue || 'Research') : (entry.data.category || 'Project');
const action = entry.collection === 'research' ? 'Read research' : 'Explore project';
const directLinks = (entry.collection === 'research'
  ? [{ href: entry.data.link, label: 'Read publication', download: false }, { href: entry.data.pdf, label: 'Download PDF', download: true }]
  : [{ href: entry.data.link, label: 'Visit project', download: false }, { href: entry.data.source, label: 'View source', download: false }]
).filter(link => link.href?.trim());
const image = entry.collection === 'research'
  ? entry.data.image || defaultResearchImage
  : projectImage(entry.data);
---

<article class:list={['entry-card', { 'research-card': entry.collection === 'research' }]}>
  <a class="entry-card-image" href={href} aria-label={`Read ${entry.data.title}`}>
    <img src={image} alt="" loading="lazy" />
  </a>
  <div class="entry-card-body">
    <div class="entry-meta"><span>{label}</span><span>{dateLabel(entry.data.date)}</span></div>
    <h3><a href={href}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
    <div class="entry-card-actions">
      <a class="text-link" href={href}>{action} <span aria-hidden="true">↗</span></a>
      {directLinks.map(link => <a class="button button-outline" href={link.href} download={link.download || undefined} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">{link.download ? '↓' : '↗'}</span></a>)}
    </div>
  </div>
</article>
