---
import type { CollectionEntry } from 'astro:content';
import { dateLabel, defaultResearchImage } from '../lib/content';

interface Props {
  entry: CollectionEntry<'projects' | 'research'>;
}

const { entry } = Astro.props;
const href = `/${entry.collection}/${entry.id}/`;
const label = entry.collection === 'research' ? (entry.data.venue || 'Research') : (entry.data.category || 'Project');
const action = entry.collection === 'research' ? 'Read research' : 'Explore project';
const image = entry.data.image || (entry.collection === 'research' ? defaultResearchImage : '');
---

<article class="entry-card">
  <a class="entry-card-image" href={href} aria-label={`Read ${entry.data.title}`}>
    {image ? <img src={image} alt="" loading="lazy" /> : <span class="image-pattern" aria-hidden="true"><span>◌</span></span>}
  </a>
  <div class="entry-card-body">
    <div class="entry-meta"><span>{label}</span><span>{dateLabel(entry.data.date)}</span></div>
    <h3><a href={href}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
    <a class="text-link" href={href}>{action} <span aria-hidden="true">↗</span></a>
  </div>
</article>
