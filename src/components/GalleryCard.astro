---
import type { GalleryItem } from '../lib/gallery';
import { galleryPreview } from '../lib/gallery-image.js';
import { dateLabel } from '../lib/content';
interface Props { item: GalleryItem; }
const { item } = Astro.props;
const preview = galleryPreview(item.image);
---

<article class="gallery-card">
  <a class="gallery-card-photo" href={item.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size photo: ${item.title}`}><img src={preview.src} srcset={preview.srcset} sizes="(max-width: 760px) 90vw, (max-width: 1050px) 45vw, 30vw" width="640" height="480" alt={item.title} loading="lazy" decoding="async" /></a>
  <div class="gallery-card-copy"><p class="entry-meta">{dateLabel(item.date)}</p><h3>{item.title}</h3>{item.location && <p class="gallery-location">{item.location}</p>}<p class="gallery-card-summary">{item.summary}</p>{item.relatedHref && <a class="text-link" href={item.relatedHref}>{item.relatedLabel} <span aria-hidden="true">↗</span></a>}</div>
</article>
