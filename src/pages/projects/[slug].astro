---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AchievementGallery from '../../components/AchievementGallery.astro';
import { dateLabel } from '../../lib/content';
import { projectImage } from '../../lib/project-image.js';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => data.published);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const image = projectImage(entry.data);
const coverCaption = entry.data.gallery.find(photo => photo.image === entry.data.image)?.caption;
---

<Base image={image} title={entry.data.title} description={entry.data.summary || undefined}>
  <article class="detail-page"><a class="back-link" href="/projects/">← All projects</a><p class="eyebrow">{entry.data.category || 'Project'} / {dateLabel(entry.data.date)}</p><h1>{entry.data.title}</h1>{entry.data.summary?.trim() && <p class="detail-summary">{entry.data.summary}</p>}<figure class="detail-cover"><img class="detail-image" src={image} alt={entry.data.title} />{coverCaption && <figcaption>{coverCaption}</figcaption>}</figure><div class="prose"><Content /></div><AchievementGallery photos={entry.data.gallery.filter(photo => photo.image !== entry.data.image)} title={entry.data.title} /><div class="detail-links">{entry.data.link && <a class="button button-primary" href={entry.data.link} target="_blank" rel="noopener noreferrer">Visit project ↗</a>}{entry.data.source && <a class="button button-outline" href={entry.data.source} target="_blank" rel="noopener noreferrer">View source ↗</a>}</div></article>
</Base>
