---
import Base from '../../layouts/Base.astro';
import profile from '../../lib/profile';
import career from '../../lib/career';
import EducationTimeline from '../../components/EducationTimeline.astro';
import { socialLink } from '../../lib/social-link';

const experience = career.experience.map(item => ({ ...item, url: socialLink(item.url)?.href }));
---

<Base title="About" description={`About ${profile.name}: ${profile.role}`}>
  <section class="page-intro"><p class="eyebrow">Academic &amp; professional background</p><h1>Background<span class="accent-dot">.</span></h1></section>

  <section class="recognition-section" aria-labelledby="education-heading">
    <div class="section-top"><div><p class="eyebrow">01 / Learning</p><h2 id="education-heading">Academic background</h2></div></div>
    <EducationTimeline />
  </section>

  <section class="recognition-section" aria-labelledby="experience-heading">
    <div class="section-top"><div><p class="eyebrow">02 / Journey</p><h2 id="experience-heading">Experience</h2></div></div>
    {experience.length ? <div class="timeline-list">{experience.map(item => <article class="timeline-item"><span class="timeline-period">{item.period}</span><div><h3>{item.role}</h3><p class="item-source">{item.organization}</p>{item.description && <p class="timeline-description">{item.description}</p>}{item.url && <a class="text-link experience-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.urlTitle?.trim() || item.organization || 'View related page'} <span aria-hidden="true">↗</span></a>}</div></article>)}</div> : <p class="empty-message">Experience will appear here when added.</p>}
  </section>

  <section class="recognition-section about-last" aria-labelledby="skills-heading">
    <div class="section-top"><div><p class="eyebrow">03 / Practice</p><h2 id="skills-heading">Skills</h2></div></div>
    {career.skills.length ? <div class="skills-grid">{career.skills.map(item => <article class="skill-card"><h3>{item.category}</h3><p>{item.items}</p></article>)}</div> : <p class="empty-message">Skills will appear here when added.</p>}
  </section>
</Base>
