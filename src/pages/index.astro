---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import ProfileOrbit from '../components/ProfileOrbit.astro';
import profile from '../data/profile.json';
import { gmailComposeUrl } from '../lib/contact';
import site from '../data/site.json';
import { published, dateLabel } from '../lib/content';

const projects = await published('projects');
const research = await published('research');
const achievements = await published('achievements');
const featured = projects.filter(entry => entry.data.featured);
const selected = (featured.length ? featured : projects).slice(0, 3);
---

<Base home>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-visual"><ProfileOrbit /></div>
    <div class="home-hero-copy">
      <p class="eyebrow">Hello, I'm</p>
      <h1 id="home-title">{profile.name}<span class="accent-dot">.</span></h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="button button-quiet" href="/about/">More about me <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-location">{profile.location || site.tagline}</p>
    </div>
  </section>

  <section class="section about-section" aria-labelledby="about-heading">
    <div class="section-heading"><p class="eyebrow">01 / About</p><h2 id="about-heading">A little about me</h2></div>
    <div class="section-copy"><p>{profile.about}</p><a class="text-link" href="/about/">Experience, education & skills <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="section-top"><div><p class="eyebrow">02 / Selected work</p><h2 id="work-heading">Featured projects</h2></div><a class="text-link" href="/projects/">All {projects.length} projects <span aria-hidden="true">↗</span></a></div>
    {selected.length ? <div class="card-grid home-card-grid">{selected.map(entry => <EntryCard entry={entry} />)}</div> : <p class="empty-message">Projects will appear here when published.</p>}
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="section-top"><div><p class="eyebrow">03 / Research</p><h2 id="research-heading">Questions & findings</h2></div><a class="text-link" href="/research/">All {research.length} entries <span aria-hidden="true">↗</span></a></div>
    {research.length ? <div class="home-research-list">{research.slice(0, 3).map(entry => <a class="home-research-item" href={`/research/${entry.id}/`}><span class="entry-meta">{entry.data.venue || 'Research'} · {dateLabel(entry.data.date)}</span><strong>{entry.data.title}</strong><span aria-hidden="true">↗</span></a>)}</div> : <p class="empty-message">Research will appear here when published.</p>}
  </section>

  <section class="section" aria-labelledby="recognition-heading">
    <div class="section-top"><div><p class="eyebrow">04 / Recognition</p><h2 id="recognition-heading">Milestones</h2></div><a class="text-link" href="/recognition/">All recognition <span aria-hidden="true">↗</span></a></div>
    {achievements.length ? <div class="milestone-grid">{achievements.slice(0, 2).map(entry => <a class="milestone" href={`/recognition/achievements/${entry.id}/`}><span class="milestone-symbol" aria-hidden="true">✦</span><div><span class="entry-meta">{dateLabel(entry.data.date)}</span><h3>{entry.data.title}</h3><p>{entry.data.summary}</p></div></a>)}</div> : <p class="empty-message">Achievements will appear here when published.</p>}
  </section>

  <section class="closing-panel"><p class="eyebrow">Let's connect</p><h2>Have a question or an idea?</h2><p>I'm always interested in thoughtful conversations and meaningful work.</p>{profile.email ? <a class="button button-light" href={gmailComposeUrl(profile.email)} target="_blank" rel="noopener noreferrer">Send an email <span aria-hidden="true">↗</span></a> : <span class="closing-note">Add your email in the Profile editor to enable contact.</span>}</section>
</Base>
