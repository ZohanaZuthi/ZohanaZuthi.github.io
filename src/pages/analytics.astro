---
import Base from '../layouts/Base.astro';
import { analytics } from '../lib/analytics';
const configured = Boolean(analytics.clientId && analytics.propertyId);
---
<Base title="Analytics" home privatePage>
  <section class="page-intro"><p class="eyebrow">Owner dashboard</p><h1>Website analytics<span class="accent-dot">.</span></h1><p>See how many visitors your portfolio reaches and which countries they visit from.</p></section>
  <section id="analytics-dashboard" data-client-id={analytics.clientId} data-property-id={analytics.propertyId} class="analytics-panel">
    {!configured && <div class="analytics-setup"><h2>Connect your Analytics account</h2><p>One-time setup is needed. Add your Google Analytics property ID and Google OAuth client ID in Pages CMS → Site settings, then save and wait for deployment. The README includes the setup steps.</p><p>To collect visits, also add your Google Analytics measurement ID.</p></div>}
    <p>This report is visible only after you connect a Google account with access to this Analytics property. It shows aggregate counts, not visitors’ names or email addresses.</p>
    <div class="analytics-controls">
      <button id="analytics-connect" class="button button-primary" disabled={!configured}>Connect Google Analytics</button>
      <label for="analytics-period">Date range <select id="analytics-period"><option value="7">Last 7 days</option><option value="30" selected>Last 30 days</option><option value="90">Last 90 days</option></select></label>
      <button id="analytics-refresh" class="button button-outline" hidden>Refresh</button>
      <button id="analytics-disconnect" class="button button-outline" hidden>Disconnect</button>
    </div>
    <p id="analytics-status" role="status" aria-live="polite">{configured ? 'Connect Google Analytics to load your visitor report.' : 'Waiting for account setup. No visitor data is displayed.'}</p>
    <div id="analytics-results" hidden>
      <div class="analytics-totals"><div><span>Users</span><strong id="analytics-users">—</strong></div><div><span>Visits (sessions)</span><strong id="analytics-sessions">—</strong></div><div><span>Page views</span><strong id="analytics-views">—</strong></div></div>
      <div class="analytics-table"><table><caption>Users by country</caption><thead><tr><th scope="col">Country</th><th scope="col">Users</th></tr></thead><tbody id="analytics-countries"></tbody></table></div>
      <p id="analytics-report-note">Google estimates user counts. Reports can take time to process, and country totals may differ from the overall user count.</p>
    </div>
  </section>
  <script>import '../scripts/analytics';</script>
</Base>
<style>
  .analytics-panel { padding: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 60px; }
  .analytics-panel p { line-height: 1.7; color: var(--secondary); }
  .analytics-controls { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin: 24px 0; }
  .analytics-controls label { display: flex; gap: 10px; align-items: center; }
  select { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 5px; padding: 10px; font: inherit; }
  button { cursor: pointer; font: inherit; } button:disabled { opacity: .55; cursor: default; }
  [hidden] { display: none !important; }
  .analytics-setup { border-left: 3px solid var(--accent); padding-left: 20px; }
  .analytics-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 30px 0; }
  .analytics-totals div { padding: 20px; background: var(--soft); border-radius: 6px; }
  .analytics-totals span { display: block; color: var(--secondary); } .analytics-totals strong { display: block; font-size: 2rem; margin-top: 8px; }
  .analytics-table { overflow-x: auto; } table { width: 100%; border-collapse: collapse; } caption { font-size: 1.25rem; font-weight: 600; text-align: start; margin-bottom: 16px; }
  th, :global(#analytics-countries td) { text-align: start; border-bottom: 1px solid var(--border); padding: 14px; } th:last-child, :global(#analytics-countries td:last-child) { text-align: end; font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) { .analytics-panel { padding: 18px; } .analytics-totals { grid-template-columns: 1fr; } .analytics-controls { align-items: stretch; flex-direction: column; } }
</style>
