---
import Base from '../../layouts/Base.astro';
import CertificateFrame from '../../components/CertificateFrame.astro';
import AchievementGallery from '../../components/AchievementGallery.astro';
import { published, dateLabel } from '../../lib/content';
const achievements = await published('achievements');
const certificates = await published('certificates');
---

<Base title="Recognition" description="Achievements, awards, and certificates.">
  <section class="page-intro"><p class="eyebrow">Milestones / {achievements.length + certificates.length} entries</p><h1>Recognition<span class="accent-dot">.</span></h1><p>Achievements, awards, and learning along the way.</p></section>

  <section class="recognition-section" aria-labelledby="certificates-heading"><div class="section-top"><div><p class="eyebrow">01 / Learning</p><h2 id="certificates-heading">Certificates</h2></div></div>
    {certificates.length ? <div class="certificate-grid">{certificates.map(entry => <article class="certificate-card"><CertificateFrame image={entry.data.image} title={entry.data.title} /><div class="certificate-body"><p class="entry-meta">{dateLabel(entry.data.date)}{entry.data.issuer ? ` · ${entry.data.issuer}` : ''}</p><h3><a href={`/recognition/certificates/${entry.id}/`}>{entry.data.title}</a></h3><p class="certificate-summary">{entry.data.summary}</p><a class="text-link" href={`/recognition/certificates/${entry.id}/`}>View details <span aria-hidden="true">↗</span></a></div></article>)}</div> : <p class="empty-message">Certificates will appear here when published.</p>}
  </section>

  <section class="recognition-section" aria-labelledby="awards-heading"><div class="section-top"><div><p class="eyebrow">02 / Milestones</p><h2 id="awards-heading">Achievements & awards</h2></div></div>
    {achievements.length ? <div class="recognition-list">{achievements.map(entry => <article class="recognition-item"><span class="recognition-date">{dateLabel(entry.data.date)}</span><div><h3><a href={`/recognition/achievements/${entry.id}/`}>{entry.data.title}</a></h3>{entry.data.organization && <p class="item-source">{entry.data.organization}</p>}<p class="recognition-summary">{entry.data.summary}</p><AchievementGallery photos={entry.data.gallery} cover={entry.data.image} title={entry.data.title} inline /><a class="text-link" href={`/recognition/achievements/${entry.id}/`}>Read full details <span aria-hidden="true">↗</span></a></div></article>)}</div> : <p class="empty-message">Achievements will appear here when published.</p>}
  </section>
</Base>
