---
import profile from '../lib/profile';
import site from '../data/site.json';
import ProfilePortrait from '../components/ProfilePortrait.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SocialLinks from '../components/SocialLinks.astro';
import EducationSummary from '../components/EducationSummary.astro';
import Icon from '../components/Icon.astro';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = site.description, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const initials = profile.name.split(' ').filter(Boolean).map(part => part[0]).slice(0, 2).join('').toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <script is:inline>
      let theme = 'light';
      try {
        const saved = localStorage.getItem('portfolio-theme');
        if (saved === 'dark' || saved === 'light') theme = saved;
      } catch {}
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#101827' : '#f8fafc');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label={`${profile.name}, home`}>
          <span class="brand-mark" aria-hidden="true">{initials}</span>
          <span>{profile.name}</span>
        </a>
        <nav class="top-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/about/">About</a>
          <a href="/projects/">Projects</a>
          <a href="/research/">Research</a>
          <a href="/recognition/">Recognition</a>
          <a href="/gallery/">Gallery</a>
          {profile.cv && <a href={profile.cv} target="_blank" rel="noopener noreferrer">CV</a>}
        </nav>
        <ThemeToggle />
      </header>

      <div class:list={['page-grid', { 'home-grid': home }]}>
        {!home && <aside class="sidebar" aria-label="Profile">
          <ProfilePortrait />
          <p class="eyebrow">Portfolio</p>
          <h2>{profile.name}</h2>
          <p class="sidebar-role">{profile.role}</p>
          <EducationSummary />
          {profile.location && <p class="sidebar-location"><Icon name="location" /><span>{profile.location}</span></p>}
          <div class="sidebar-rule"></div>
          <SocialLinks />
        </aside>}

        <main id="main" class="main-content"><slot /></main>
      </div>

      <footer class="footer"><span>© {new Date().getFullYear()} {profile.name}</span><SocialLinks variant="footer" /></footer>
    </div>
  </body>
</html>
